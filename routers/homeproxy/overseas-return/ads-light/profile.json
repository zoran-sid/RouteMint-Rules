{
  "schema": 1,
  "client": "homeproxy",
  "preset": "overseas-return",
  "ads": "ads-light",
  "groups": {
    "ai": {
      "label": "🤖 AI 服务",
      "default": "direct"
    },
    "cn_return": {
      "label": "🏠 回国",
      "default": "reject"
    },
    "proxy": {
      "label": "🚀 节点选择",
      "default": "proxy"
    }
  },
  "rules": [
    {
      "category": "private",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/private/private.srs",
      "domains": true,
      "ips": true,
      "dns": "local"
    },
    {
      "category": "reject-tracker",
      "policy": "reject",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/reject-tracker/reject-tracker.srs",
      "domains": true,
      "ips": false,
      "dns": "service"
    },
    {
