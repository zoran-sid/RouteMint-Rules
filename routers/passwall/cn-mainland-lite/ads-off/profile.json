{
  "schema": 1,
  "client": "passwall",
  "preset": "cn-mainland-lite",
  "ads": "ads-off",
  "groups": {
    "ai": {
      "label": "🤖 AI 服务",
      "default": "proxy"
    },
    "proxy": {
      "label": "🚀 节点选择",
      "default": "proxy"
    }
  },
  "rules": [
    {
      "category": "private",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/private/private.srs",
      "domains": true,
      "ips": true,
      "dns": "local"
    },
    {
      "category": "ai",
      "policy": "ai",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/ai/ai.srs",
      "domains": true,
      "ips": false,
      "dns": "service"
    },
    {
      "category": "game-download",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/game-download/game-download.srs",
      "domains": true,
      "ips": false,
      "dns": "local"
    },
    {
      "category": "baidu-pan",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/baidu-pan/baidu-pan.srs",
      "domains": true,
      "ips": false,
      "dns": "local"
    },
    {
      "category": "game-platform",
      "policy": "proxy",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/game-platform/game-platform.srs",
      "domains": true,
      "ips": false,
      "dns": "service"
    },
    {
      "category": "steam-direct",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/steam-direct/steam-direct.srs",
      "domains": true,
      "ips": true,
      "dns": "local"
    },
    {
      "category": "cn",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/cn/cn.srs",
      "domains": true,
      "ips": false,
      "dns": "local"
    },
    {
      "category": "cn-ip",
      "policy": "direct",
      "url": "https://raw.githubusercontent.com/zoran-sid/RouteMint-Rules/release/rules/cn-ip/cn-ip.srs",
      "domains": false,
      "ips": true,
      "dns": "service"
    }
  ],
  "default": "proxy",
  "core": "sing-box >= 1.14",
  "update_interval": "1d"
}
